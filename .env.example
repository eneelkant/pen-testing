# Copy to .env and fill only what you need. Never commit real secrets.

# Platform
PEN_WORK_DIR=workspaces
PEN_REPORTS_DIR=reports/out
PEN_SCOPES_FILE=scopes/registry.yaml
PEN_REQUIRE_SCOPE=true
PEN_ALLOW_PRODUCTION_ACTIVE=false
PEN_DEFAULT_TIMEOUT=3600
# Local artifact retention for `pen-testing cleanup` (dry-run unless --apply).
# Integer days, or off. Status checks never delete files.
PEN_ASSESSMENT_RETENTION_DAYS=14
# Process-local cap on concurrent non-dry-run scans (single operator, not a cluster quota).
PEN_MAX_INFLIGHT_SCANS=4
# Live scans that skip the registry still use this limit. It does not disable egress checks.
PEN_SKIP_SCOPE_RATE_LIMIT_RPS=1
# Optional Fernet key for assessment records and backups. Never commit a real key.
# PEN_DATA_KEY=
# PEN_REQUIRE_DATA_ENCRYPTION=0
# PEN_DOCTOR_STRICT=0
PEN_SHANNON_PACKAGE=@keygraph/shannon@3.4.0
PEN_BRIAR_PACKAGE=briar-pentest==0.4.62
# Briar execution: compose (default, pen-scanner-* networks) or host (uncontained)
PEN_BRIAR_EXEC=compose
# PEN_COMPOSE_DIR=/path/to/pen-testing
# Live Briar gates (both default off)
# PEN_ALLOW_BRIAR_LIVE=0
# PEN_ALLOW_BRIAR_HOST_NET=0   # required only when PEN_BRIAR_EXEC=host
# Proxied destinations for egress-gateway (deny-by-default when empty)
# PEN_PROXY_ALLOW_HOSTS=staging.example.invalid
# Optional: python used for Briar host mode
# PEN_BRIAR_PYTHON=.venv-briar/bin/python
# Shannon live gates (default off)
# PEN_ALLOW_SHANNON_LIVE=0
# PEN_ALLOW_SHANNON_UNCONTAINED_NET=0  # skip controlled shannon-net prepare
# PEN_ALLOW_SHANNON_FULL_PIPELINE=0  # full pentest pipeline (not --validate-model); keep off until lab evidence exists
# PEN_PROXY_ALLOW_PORTS=80,443

# Shannon / Briar AI providers (optional until a provider is used)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Setup non-interactive confirmations (installers / setup scripts)
# PEN_ASSUME_YES=0

# Optional platform config path for MCP server
# PEN_PLATFORM_CONFIG=examples/platform.config.yaml
