#!/usr/bin/env bash
# Docker CLI wrapper for controlled Shannon runs.
# Injects HTTP(S)_PROXY into `docker run` worker containers on shannon-net.
set -euo pipefail

REAL_DOCKER="${PEN_REAL_DOCKER:-/usr/bin/docker}"
if [[ ! -x "$REAL_DOCKER" ]]; then
  REAL_DOCKER="$(type -P docker || true)"
fi
[[ -n "$REAL_DOCKER" && -x "$REAL_DOCKER" ]] || {
  echo "shannon-docker-wrap: could not locate real docker binary" >&2
  exit 127
}
# Avoid recursion if PATH points at this wrap.
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
if [[ "$(readlink -f "$REAL_DOCKER" 2>/dev/null || echo "$REAL_DOCKER")" == "$SELF" ]]; then
  echo "shannon-docker-wrap: PEN_REAL_DOCKER must point at the real docker binary" >&2
  exit 127
fi

PROXY_URL="${PEN_SHANNON_HTTP_PROXY:-http://egress-gateway:3128}"
NO_PROXY_VAL="${PEN_SHANNON_NO_PROXY:-egress-gateway,shannon-temporal,localhost,127.0.0.1,::1}"

if [[ "${1:-}" == "run" ]]; then
  shift
  exec "$REAL_DOCKER" run \
    -e "HTTP_PROXY=$PROXY_URL" \
    -e "HTTPS_PROXY=$PROXY_URL" \
    -e "http_proxy=$PROXY_URL" \
    -e "https_proxy=$PROXY_URL" \
    -e "NO_PROXY=$NO_PROXY_VAL" \
    -e "no_proxy=$NO_PROXY_VAL" \
    "$@"
fi

exec "$REAL_DOCKER" "$@"
