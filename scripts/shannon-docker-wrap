#!/usr/bin/env bash
# Docker CLI wrapper for controlled Shannon runs.
# Injects HTTP(S)_PROXY into `docker run` worker containers on shannon-net.
set -euo pipefail

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
resolve_real_docker() {
  local candidate resolved
  for candidate in "${PEN_REAL_DOCKER:-}" /usr/bin/docker /usr/local/bin/docker; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    resolved="$(readlink -f "$candidate" 2>/dev/null || echo "$candidate")"
    [[ "$resolved" == "$SELF" ]] && continue
    # Skip other PATH shims that ultimately point at this wrap.
    if [[ -L "$candidate" ]]; then
      local dest
      dest="$(readlink -f "$candidate" 2>/dev/null || true)"
      [[ "$dest" == "$SELF" ]] && continue
    fi
    printf '%s\n' "$candidate"
    return 0
  done
  # Last resort: first docker on PATH that is not this script.
  local p
  while IFS= read -r p; do
    [[ -n "$p" && -x "$p" ]] || continue
    resolved="$(readlink -f "$p" 2>/dev/null || echo "$p")"
    [[ "$resolved" == "$SELF" ]] && continue
    printf '%s\n' "$p"
    return 0
  done < <(type -aP docker 2>/dev/null || true)
  return 1
}
REAL_DOCKER="$(resolve_real_docker || true)"
[[ -n "$REAL_DOCKER" && -x "$REAL_DOCKER" ]] || {
  echo "shannon-docker-wrap: could not locate real docker binary (set PEN_REAL_DOCKER=/usr/bin/docker)" >&2
  exit 127
}

PROXY_URL="${PEN_SHANNON_HTTP_PROXY:-http://egress-gateway:3128}"
# On-net fixtures / Temporal / mock LLM must bypass the explicit CONNECT proxy.
NO_PROXY_VAL="${PEN_SHANNON_NO_PROXY:-egress-gateway,shannon-temporal,fixture-shannon,shannon-llm-mock,shannon-redirect,localhost,127.0.0.1,::1}"
NET_NAME="${PEN_SHANNON_NET_NAME:-shannon-net}"
COMPOSE_OVERRIDE="${PEN_SHANNON_COMPOSE_OVERRIDE:-}"
if [[ -z "$COMPOSE_OVERRIDE" ]]; then
  COMPOSE_OVERRIDE="$(cd "$(dirname "$SELF")/.." && pwd)/scripts/shannon-compose-external-net.yml"
fi

if [[ "${1:-}" == "run" ]]; then
  shift
  exec "$REAL_DOCKER" run \
    -e "HTTP_PROXY=$PROXY_URL" \
    -e "HTTPS_PROXY=$PROXY_URL" \
    -e "http_proxy=$PROXY_URL" \
    -e "https_proxy=$PROXY_URL" \
    -e "NO_PROXY=$NO_PROXY_VAL" \
    -e "no_proxy=$NO_PROXY_VAL" \
    "$@"
fi

# When platform-managed shannon-net exists, inject external:true override so
# Shannon's bundled compose can attach Temporal without recreating the network.
if [[ "${1:-}" == "compose" ]]; then
  shift
  if [[ -f "$COMPOSE_OVERRIDE" ]] \
    && "$REAL_DOCKER" network inspect "$NET_NAME" >/dev/null 2>&1; then
    managed="$("$REAL_DOCKER" network inspect -f '{{index .Labels "pen.managed"}}' "$NET_NAME" 2>/dev/null || true)"
    if [[ "$managed" == "1" ]]; then
      args=()
      inserted=0
      for a in "$@"; do
        if [[ "$inserted" -eq 0 && "$a" =~ ^(up|down|ps|logs|stop|start|restart|pull|build|run|exec|config|create|rm|kill)$ ]]; then
          args+=(-f "$COMPOSE_OVERRIDE")
          inserted=1
        fi
        args+=("$a")
      done
      if [[ "$inserted" -eq 0 ]]; then
        args+=(-f "$COMPOSE_OVERRIDE")
      fi
      exec "$REAL_DOCKER" compose "${args[@]}"
    fi
  fi
  exec "$REAL_DOCKER" compose "$@"
fi

exec "$REAL_DOCKER" "$@"
